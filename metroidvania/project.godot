; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Metroidvania"
run/main_scene="uid://dxcdp1b0ifojh"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://assets/icon.svg"

[autoload]

SignalHub="*uid://d1h1ts2ecguhb"
Data="*uid://dtw0yov63xymq"
TransitionLayer="*uid://uefw68w0re8f"

[display]

window/size/viewport_width=1440
window/size/viewport_height=810
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="Metroidvania"

[file_customization]

folder_colors={
"res://assets/": "yellow",
"res://game/": "red",
"res://shaders/": "green"
}

